# A-Town Café — Environment Configuration
# Copy this file to .env or .env.local to customize environment values

# Public Website URL
VITE_SITE_URL="https://atowncafe.com"

# App Title & Meta
VITE_SITE_NAME="A-Town Café"
VITE_SITE_DESCRIPTION="Your everyday escape for specialty coffee, hearty comfort food, cozy wooden interiors, and moments worth slowing down for."

# Optional Third-Party Services (leave blank if not using)
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_GOOGLE_MAPS_KEY=
